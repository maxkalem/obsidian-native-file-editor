{
  "name": "native-file-editor",
  "version": "0.1.0",
  "description": "Obsidian plugin: open and edit code, text and Office files in place, rendered from their own bytes, with no network and a backup before every write.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "size": "node esbuild.config.mjs production --size",
    "test": "vitest run",
    "test:e2e": "bash tests/e2e/run.sh"
  },
  "keywords": [
    "obsidian",
    "codemirror",
    "docx",
    "xlsx",
    "pptx",
    "editor"
  ],
  "author": "maxkalem",
  "license": "GPL-3.0-only",
  "devDependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-php": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.4",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6",
    "@fazelstudio/codemirror-lang-astro": "^0.2.0",
    "@fazelstudio/codemirror-lang-prisma": "^0.2.0",
    "@replit/codemirror-lang-nix": "^6.0.1",
    "@replit/codemirror-lang-solidity": "^6.0.2",
    "@replit/codemirror-lang-svelte": "^6.0.0",
    "@lezer/common": "^1.5.2",
    "@lezer/highlight": "^1.2.3",
    "@types/node": "^22.0.0",
    "codemirror-lang-elixir": "^4.0.1",
    "codemirror-lang-hcl": "^0.2.0",
    "esbuild": "^0.28.2",
    "obsidian": "1.13.1",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.0"
  }
}
